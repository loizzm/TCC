# Ambiente virtual
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Cache de testes
.pytest_cache/
.coverage
htmlcov/

# Dataset gerado (grande, reproduzível via dataset/generator.py)
data/

# Editores / SO
.vscode/
.idea/
.DS_Store

# Checkpoints dos pilotos de triagem (3 epocas, ~49 MB): nao sao modelos
# utilizaveis, e os numeros deles estao em HANDOFF_P2_6.md §3.3
models/piloto_*.pt

# Checkpoint de treino INTERROMPIDO (5 epocas de 25, run morto por travamento):
# mesma razao dos `piloto_*` acima — nao e modelo utilizavel, e os numeros das
# 5 epocas ficam em logs/train_base32_interrompido.log
models/*_interrompido.pt

# Copia de seguranca local do checkpoint anterior a uma promocao. O conteudo
# ja esta no historico (`git show <commit>:models/unet_stageA.pt`), entao
# versiona-la so duplicaria o arquivo na arvore.
models/*_backup.pt

# Checkpoints POR EPOCA do retreino (25 x ~31 MB = ~775 MB). Sao insumo de
# selecao, nao modelos: existem porque o IoU_val e quase cego ao defeito do
# plato (HANDOFF_P2_7 §40.9) e a escolha do checkpoint precisa ser feita depois
# do treino, por `seleciona_checkpoint.py`. So o VENCEDOR e promovido e
# versionado; os outros 24 sao descartaveis e reproduziveis pelo log.
models/epocas_*/

# Saida `--out` do retreino: sao os MESMOS pesos que `models/unet_stageA.pt`
# depois da promocao (verificado tensor a tensor), entao versiona-la duplicaria
# o arquivo na arvore. A rastreabilidade vem de `logs/train_kneg.log`, que
# registra a receita e a epoca vencedora.
models/unet_stageA_kneg.pt

# Planos e specs do fluxo superpowers: sao artefatos de sessao (rascunhos de
# execucao gerados por agente), nao documentacao do trabalho. O registro que
# sobrevive esta em TIMELINE.md e nextSteps.md.
docs/

# Espaco de trabalho do fluxo subagent-driven-development: ledger, briefs e
# pacotes de revisao de uma execucao. Mesma razao de `docs/`: artefato de
# sessao, nao documentacao do trabalho.
.superpowers/

# Saida `--out` do retreino do estrato fora-da-familia. MESMA razao do
# `unet_stageA_kneg.pt`, com um detalhe a mais: aqui ela nem e' o modelo
# promovido. O `--out` guarda o melhor por `IoU_val` (epoca 13); a promocao
# foi da epoca 17, escolhida por `seleciona_checkpoint_nmp.py` contra o
# objetivo do retreino e tres guardas. Versiona-la sugeriria que o IoU_val
# decidiu, que e exatamente o erro que o seletor existe para evitar.
models/unet_stageA_nmp.pt

# Checkpoints de retreinos NAO promovidos. Mesma razao dos `piloto_*`: nao sao
# modelos utilizaveis, e os numeros deles vivem nos logs e em
# reports/selecao_*.json.
models/unet_stageA_multi.pt
models/unet_stageA_ruido.pt
models/unet_stageA_render2.pt
models/unet_stageA_combinado2.pt
models/unet_stageA_multi_thr01_abortado.pt
models/cabeca_contagem_congelada.pt

# LOGS de treino, geracao e medicao. Sao saida de execucao, nao fonte: o que
# importa deles (as tabelas de epoca, as varreduras) esta citado nas mensagens
# de commit, nos comentarios do codigo e nos relatorios. Versiona-los enchia o
# historico de ruido que ninguem le duas vezes.
logs/

# CODIGO DE FRENTES ENCERRADAS, preservado como texto. Nao e executavel nem
# importado por nada — e evidencia do que foi tentado. Fica no disco e no
# historico (ver MULTI_DEGRAU.md), fora do versionamento corrente.
docs_frente/

# RELATORIOS E LOTES DE AVALIACAO. Saida de medicao: os .md de criterio sao
# REGERADOS pelos conftest a cada rodada de teste, os JSON e as figuras dos
# lotes sao derivados dos scripts com a semente registrada. Fica so no disco.
# Historico: `git checkout 77dfb74 -- reports/` traz tudo de volta.
reports/
