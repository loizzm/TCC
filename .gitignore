# Ambiente virtual
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Cache de testes
.pytest_cache/
.coverage
htmlcov/

# Dataset gerado (grande, reproduzível via dataset/generator.py)
data/

# Editores / SO
.vscode/
.idea/
.DS_Store

# Checkpoints dos pilotos de triagem (3 epocas, ~49 MB): nao sao modelos
# utilizaveis, e os numeros deles estao em HANDOFF_P2_6.md §3.3
models/piloto_*.pt

# Checkpoint de treino INTERROMPIDO (5 epocas de 25, run morto por travamento):
# mesma razao dos `piloto_*` acima — nao e modelo utilizavel, e os numeros das
# 5 epocas ficam em logs/train_base32_interrompido.log
models/*_interrompido.pt

# Copia de seguranca local do checkpoint anterior a uma promocao. O conteudo
# ja esta no historico (`git show <commit>:models/unet_stageA.pt`), entao
# versiona-la so duplicaria o arquivo na arvore.
models/*_backup.pt

# Checkpoints POR EPOCA do retreino (25 x ~31 MB = ~775 MB). Sao insumo de
# selecao, nao modelos: existem porque o IoU_val e quase cego ao defeito do
# plato (HANDOFF_P2_7 §40.9) e a escolha do checkpoint precisa ser feita depois
# do treino, por `seleciona_checkpoint.py`. So o VENCEDOR e promovido e
# versionado; os outros 24 sao descartaveis e reproduziveis pelo log.
models/epocas_*/

# Saida `--out` do retreino: sao os MESMOS pesos que `models/unet_stageA.pt`
# depois da promocao (verificado tensor a tensor), entao versiona-la duplicaria
# o arquivo na arvore. A rastreabilidade vem de `logs/train_kneg.log`, que
# registra a receita e a epoca vencedora.
models/unet_stageA_kneg.pt

# Planos e specs do fluxo superpowers: sao artefatos de sessao (rascunhos de
# execucao gerados por agente), nao documentacao do trabalho. O registro que
# sobrevive esta em TIMELINE.md e nextSteps.md.
docs/
